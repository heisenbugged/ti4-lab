{
  "name": "ti4-lab",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "tsx ./server.ts",
    "discord:deploy": "tsx ./src/discord/deployCommands.ts",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx ./server.ts",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "db:migrations": "drizzle-kit generate --dialect=sqlite --out=./src/drizzle/migrations --schema=./src/drizzle/schema.server.ts",
    "db:backup": "flyctl ssh sftp get -a ti4-lab /data/sqlite.db ~/Downloads/ti4-lab_$(date +'%d_%m_%Y').db",
    "db:repair-preset-closed-tiles": "tsx ./scripts/repair-preset-closed-tiles.ts",
    "typecheck": "tsc",
    "test": "vitest",
    "sync-voices": "node sync-voices-wrangler.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.914.0",
    "@base-ui/react": "1.8.0",
    "@dnd-kit/core": "^6.1.0",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.61",
    "better-sqlite3": "^12.8.0",
    "cross-env": "^7.0.3",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "express": "^5.2.1",
    "howler": "^2.2.4",
    "immer": "^10.1.1",
    "isbot": "^4.1.0",
    "jotai": "^2.8.3",
    "jotai-zustand": "^0.4.0",
    "posthog-js": "^1.249.0",
    "prom-client": "^15.1.3",
    "react": "^19",
    "react-dom": "^19",
    "react-qr-code": "^2.0.15",
    "skia-canvas": "^3.0.8",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "srvx": "^1.0.5",
    "tsx": "^4.12.0",
    "uuid": "^9.0.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@flydotio/dockerfile": "^0.5.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/howler": "^2.2.12",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.7.4",
    "@typescript-eslint/parser": "^6.7.4",
    "@vitejs/plugin-react": "^6",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.21.4",
    "eslint": "^8.38.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "prettier": "^3.2.5",
    "typescript": "^5.1.6",
    "vite": "^8",
    "vitest": "^5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
